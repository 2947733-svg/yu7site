{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "script-type": "off",
    "no-trailing-whitespace": "off",
    "no-implicit-button-type": "warn",
    "long-title": "off",
    "no-redundant-for": "off",
    "wcag/h63": "warn",
    "element-required-attributes": ["error", {
      "exclude": ["lang"]
    }]
  },
  "elements": [
    "html5"
  ]
}
